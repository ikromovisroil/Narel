# Serverda: kamida 40 belgili tasodifiy kalit, aks holda sayt ishga tushmaydi. Yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Server xavfsizligi (DEBUG=False bo'lganda) ----------
# nginx orqasida bo'lsa 1 (mijozning haqiqiy IP manzili uchun). To'g'ridan-to'g'ri bo'lsa 0
NUM_PROXIES=0
# HTTPS majburiy (serverda sukut bo'yicha yoqiq). Sertifikat o'rnatilmaguncha False qo'ying
HTTPS=
SECURE_HSTS_SECONDS=31536000
# Django admin HTTPS orqali: https://narel.uz,https://admin.narel.uz
CSRF_TRUSTED_ORIGINS=
# Django admin manzili — standart "admin" o'rniga boshqa nom qo'ying (masalan narel-boshqaruv-7k2)
DJANGO_ADMIN_URL=admin
# Bir nechta worker bo'lsa tavsiya etiladi (pip install redis). Bo'sh — ma'lumotlar bazasi keshi
REDIS_URL=
# Harakatlar jurnali necha kun saqlanadi (python manage.py prune_audit)
AUDIT_KEEP_DAYS=365
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Lokal test uchun admin hisob (faqat dev)
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=change-me

# Lokal test uchun mijoz hisobi (faqat dev)
TEST_CUSTOMER_USERNAME=test_mijoz
TEST_CUSTOMER_PASSWORD=change-me

# Google orqali kirish (ixtiyoriy): Google Cloud Console -> Credentials -> OAuth Client ID (Web application)
GOOGLE_CLIENT_ID=

# SMS kod (Eskiz.uz). Bo'sh bo'lsa va DEBUG=True — kod server konsolida ko'rinadi (test rejimi)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Balans shundan kam bo'lsa admin panelda ogohlantirish
ESKIZ_LOW_BALANCE=20000
# Android'da kodni avtomatik to'ldirish: sayt domeni (masalan narel.uz). SMS matni o'zgaradi — Eskiz'da qayta moderatsiya kerak
SMS_OTP_DOMAIN=
