# Rendershop — server sozlamalari. Nusxa oling:  cp .env.prod.example .env  va to'ldiring.
# .env GitHub'ga yuklanmaydi (.gitignore). Parol va kalitlarni hech kimga bermang.

# ---------- Domen ----------
# Do'kon: https://rendershop.uz, admin panel: https://rendershop.uz/seller/
DOMAIN=rendershop.uz
# SSL sertifikat (Let's Encrypt) ogohlantirishlari shu emailga keladi
CERTBOT_EMAIL=

# ---------- Django ----------
# Kamida 40 belgili tasodifiy kalit. Yaratish (serverda):
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Django admin manzili: https://rendershop.uz/admin/
DJANGO_ADMIN_URL=admin
# HTTPS majburiy. Faqat SSL sertifikati olinmaguncha vaqtincha False qilish mumkin
HTTPS=True
SECURE_HSTS_SECONDS=31536000
AUDIT_KEEP_DAYS=365

# ---------- Ma'lumotlar bazasi ----------
POSTGRES_DB=shop
POSTGRES_USER=shop
# Uzun tasodifiy parol (yuqoridagi buyruq bilan yaratsa bo'ladi)
POSTGRES_PASSWORD=

# ---------- SMS va Google (ixtiyoriy) ----------
# Bularni admin panelda ham sozlash mumkin: Sozlamalar → Integratsiyalar (u yerdagisi ustun)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_LOW_BALANCE=20000
SMS_OTP_DOMAIN=
GOOGLE_CLIENT_ID=
